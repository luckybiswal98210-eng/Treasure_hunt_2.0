# ==============================================================================
# Campus Treasure Hunt 2.0 - Environment Configuration
# ==============================================================================

PORT=3000

# MongoDB Atlas Database URI (Required for Vercel persistent storage across serverless lambdas)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

MONGODB_DB_NAME=campus_hunt
MONGODB_SUBMISSIONS_COLLECTION=submissions
MONGODB_CREDENTIALS_COLLECTION=credentials
MONGODB_QUESTIONS_COLLECTION=questions

# Admin secret token for reset operations
ADMIN_RESET_TOKEN=huntadmin2026

